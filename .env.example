# --- LLM provider: "google" (default) or "anthropic" ---
LLM_PROVIDER=google

# --- API keys (only the one for the active provider is required) ---
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional per-role model overrides (defaults live in src/config.py) ---
# GOOGLE_MODEL_REASONING=gemini-3.1-pro-preview
# GOOGLE_MODEL_ROUTING=gemini-3-flash
# ANTHROPIC_MODEL_REASONING=claude-sonnet-5-5
# ANTHROPIC_MODEL_ROUTING=claude-haiku-5-5

# --- ParaView: directory containing pvbatch / paraview executables ---
# Windows example: C:\Program Files\ParaView 6.1.0\bin
PARAVIEW_PATH=

# --- Pipeline behaviour ---
HITL_ENABLED=true
MAX_CAD_RETRIES=3
